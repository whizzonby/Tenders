# Copy this file to .env and fill in real values.

PORT=3000

# Free API key from https://sam.gov (Workspace > Account Details > Request Public API Key)
# Without this, the US federal (SAM.gov) source is skipped — everything else still works.
SAM_GOV_API_KEY=

# Cron schedule for automatic re-scraping (standard 5-field cron syntax). Default: every 6 hours.
CRON_SCHEDULE=0 */6 * * *
